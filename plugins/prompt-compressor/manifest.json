{
  "id": "com.tyk.prompt-compressor",
  "version": "1.0.2",
  "name": "Prompt Compressor",
  "description": "Shrinks LLM request bodies on the Microgateway before they reach the vendor, starting with tool outputs. Output is deterministic per policy so the provider's prompt cache keeps hitting, savings are measured next to the cache-read share, and every failure passes the request through unchanged.",
  "capabilities": {
    "hooks": ["studio_ui", "post_auth", "on_response"],
    "primary_hook": "post_auth"
  },
  "permissions": {
    "services": ["kv.readwrite", "control.send", "pricing.read", "apps.read", "llms.read"],
    "ui": ["sidebar.register", "route.register"],
    "rpc": ["call"],
    "routes": ["GET:/plugin/com.tyk.prompt-compressor/rpc/*"]
  },
  "ui": {
    "slots": [
      {
        "slot": "sidebar.section",
        "label": "Prompt Compressor",
        "icon": "/assets/icon.svg",
        "items": [
          {
            "type": "route",
            "path": "/admin/prompt-compressor/dashboard",
            "title": "Dashboard",
            "mount": {
              "kind": "webc",
              "tag": "prompt-compressor-dashboard",
              "entry": "/ui/webc/dashboard.js"
            }
          },
          {
            "type": "route",
            "path": "/admin/prompt-compressor/policies",
            "title": "Policies",
            "mount": {
              "kind": "webc",
              "tag": "prompt-compressor-policies",
              "entry": "/ui/webc/policies.js"
            }
          },
          {
            "type": "route",
            "path": "/admin/prompt-compressor/preview",
            "title": "Preview",
            "mount": {
              "kind": "webc",
              "tag": "prompt-compressor-preview",
              "entry": "/ui/webc/preview.js"
            }
          }
        ]
      }
    ]
  },
  "rbac": {
    "resources": [
      {
        "key": "policies",
        "label": "Compression policies",
        "description": "Read or change the compression mode, policies and their bindings to LLMs and Apps.",
        "actions": ["read", "write"]
      },
      {
        "key": "savings",
        "label": "Compression savings",
        "description": "See the savings dashboard: tokens and estimated cost saved, cache-read share and policy changes, by App and LLM.",
        "actions": ["read"]
      },
      {
        "key": "preview",
        "label": "Compression preview",
        "description": "Run the compressor over a pasted or uploaded request body and see its output and decisions. Inputs are not stored.",
        "actions": ["read", "execute"]
      }
    ],
    "rpc_methods": {
      "getStatus": "read",
      "validateConfig": "policies:read",
      "getEditor": "policies:read",
      "saveConfig": "policies:write",
      "getSavings": "savings:read",
      "preview": "preview:execute",
      "getPreviewOptions": "preview:execute"
    }
  },
  "compat": {
    "min_gateway_version": "1.0.0",
    "min_studio_version": "2.3.0"
  },
  "security": {
    "csp": "script-src 'self'; object-src 'none'; frame-ancestors 'none'"
  },
  "assets": [
    "/assets/icon.svg",
    "/ui/webc/dashboard.js",
    "/ui/webc/policies.js",
    "/ui/webc/preview.js"
  ]
}
